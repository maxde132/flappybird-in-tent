load "io";
load "math";
load "stdtent";
grid = vec.fill(128, ". ");
birdx = 0;
birdy = 3;
oldbirdx = 0;
oldbirdy = 0;
gameover = 0;
form printgrid() {
	i = 0;
	
	while i < 64 {
		println(grid@i, grid@(i+1), grid@(i+2), grid@(i+3), grid@(i+4), grid@(i+5), grid@(i+6), grid@(i+7));
		i = i + 8;
	}
	println(" ");
}
form readgrid(x, y) {
	one = y+1;
	two = one * 8;
	three = two - 8;
	four = three + x;
	return grid@four;
}
form changegrid(x, y, newchar) {
	~ i hate order of operations lol
	one = y+1;
	two = one * 8;
	three = two - 8;
	four = three + x;
	grid@four = newchar;
}

form drawpipes() {
	i = 0;
	rand = rand();
	del = 0;
	while i < 8 {
		changegrid(7, i, "| ");
		i = i + 1;
	}
	if rand < 0.125 < 0.25 { del = 1; }
	if rand < 0.125 < 0.25 { del = 1; }
	if rand < 0.251 < 0.375 { del = 2; }
	if rand < 0.376 < 0.5 { del = 3; }
	if rand < 0.501 < 0.625 { del = 4; }
	if rand < 0.626 < 0.75 { del = 5; }
	if rand < 0.751 < 0.875 { del = 6; }
	if rand < 0.876 < 1 { del = 6; }
	else
	changegrid(7, del, ". ");
	changegrid(7, del +1, ". ");
	changegrid(7, del+2, ". ");	
}
form movepipes() {
	y = 0;
	while y < 8 {
		x = 0;
		while x < 8 {
			sx = x + 1;
			char = readgrid(sx, y);
			if char == "X " { char = ". "; }
			changegrid(x, y, char);
			x = x + 1;
		}
		y = y + 1;
	}
	
}
form wait() {
	i = 0;
	while i < 100000 {
		i = i + 1;
	}
}
form movebird() {
	input = stoi(input("1(up) or 2(down) or 3(straight)"));
	if input == 1 {
		if birdy > 0 {
			oldbirdy = birdy;
			birdy--;
			if readgrid(1, birdy) == "| " {
				gameover = 1;
				while 1 == 1 { println("Game over!, Ctrl-C to stop this");} 
			}
			changegrid(0, birdy, "X ");
		}
	}	
	if input == 2 {
		if birdy > 0 {
			oldbirdy = birdy;
			birdy++;
			if readgrid(1, birdy) == "| " {
				gameover = 1;
				while 1 == 1 { println("Game over!, Ctrl-C to stop this");}
                        }
                        changegrid(0, birdy, "X ");

		}
	}
	if input == 3 {
		if readgrid(1, birdy) == "| " {
				gameover = 1;
				
				while 1 == 1 { println("Game over!, Ctrl-C to stop this");}
		}
		changegrid(0, birdy, "X ");
		oldbirdy = birdy+1;
	changegrid(0, oldbirdy, ". ");
	}
		
}
while 1 == 1 {
	i = 0;
	while i < 3 {
		printgrid();
		wait();
		movepipes();
		movebird();
		i++;
	}
	printgrid();
	wait();
	drawpipes();
	movepipes();
	movebird();
}
